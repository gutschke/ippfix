#!/bin/bash -e
#
# defont: rewrite a PDF so that it contains no embedded font programs.
#
# Ghostscript's -dNoOutputFonts converts every glyph to a filled path. The text
# stays vector, so the printer's own rasteriser still renders it at full device
# precision and edge enhancement still applies; only the font programs, and the
# interpreter's need to cache them, go away.
#
# Reads a PDF on stdin and writes one on stdout. Input that is not a PDF is
# passed through untouched, so raster and PCL jobs are unaffected.
#
export LC_ALL=C
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH}"

GS="${GS:-gs}"

# Outlining a page inlines a full outline at every glyph occurrence, so a long
# document can grow past what the printer will accept as a PDF at all -- HP
# LaserJet Pro devices advertise pdf-k-octets-supported of 0-75000. Past this
# size the page is rasterised instead. That costs less than it sounds: the
# raster is contone at the device's own resolution, so the printer still does
# its own halftoning and edge processing, and only geometry precision is given
# up -- edges land on the 600 dpi grid instead of wherever the RIP would have
# put them. It is not the blurry "print as image" path, which is blurry from
# JPEG quality 40 rather than from rastering. A job that prints slightly less
# precisely beats one the printer rejects outright.
MAX_PDF_BYTES="${MAX_PDF_BYTES:-60000000}"
RASTER_DPI="${RASTER_DPI:-600}"
# 19 = SRGB24, the colour space these printers advertise first. 18 is W8 grey,
# which halves the size and avoids composite-black fringing on text.
RASTER_COLORSPACE="${RASTER_COLORSPACE:-19}"
# Which Ghostscript raster device to fall back to. Empty means this printer
# accepts no raster format we can produce, so there is no fallback for it.
RASTER_DEVICE="${RASTER_DEVICE:-appleraster}"

# Rasterise the input straight away instead of outlining it first. Empty means
# the normal path: outline, and rasterise only if the result is over
# MAX_PDF_BYTES.
#
# This exists because "rasterise this document" and "the size limit is zero"
# are not the same request, though they look alike. A size of zero is only
# reached after the pdfwrite pass and the three fail-safes below it, and each
# of those returns the ORIGINAL document and exits 0 -- so a document that
# loses a shading on the way through comes back as the very PDF the caller was
# trying not to send. The fail-safes are right for outlining, which can lose
# content; they have nothing to check here, because the raster is taken from
# the original input and not from the outlined copy. Asking for raster
# explicitly also saves a full outlining pass over a document whose outlined
# form nobody is ever going to look at.
RASTER_ONLY="${RASTER_ONLY:-}"

# Which side of the sheet each page is to land on: one of the three values IPP
# has, or empty for "say nothing", which is what a caller that has never heard
# of this field asks for by saying nothing and is exactly the behaviour this
# script had before the field existed.
#
# This field exists because the raster tier does not merely fail to carry the
# IPP sides attribute -- it OVERRIDES it. Ghostscript's raster devices write a
# duplex field into every page header of the stream they produce, and default
# it to one-sided unless told otherwise, and the printer believes the stream
# over the attribute. Measured on real hardware: a two page URF produced here
# without these flags, sent with sides=two-sided-long-edge and
# media=na_letter_8.5x11in, was answered 0x0000 with an empty
# unsupported-attributes, reported two impressions and completed successfully
# -- and came out as two simplex sheets. Every layer reported success.
#
# So a client that asks for duplex on a document just large enough to trip the
# raster tier silently gets simplex, and nothing anywhere says so. That is the
# exact failure this proxy exists to remove, which is why the stream is made to
# repeat what the job asked for instead of being left to its own default.
SIDES="${SIDES:-}"

# Convert only part of the document. Empty means all of it, which is what a
# caller that has never heard of these fields asks for by saying nothing.
#
# Both ends are inclusive and 1-based, exactly as Ghostscript's -dFirstPage and
# -dLastPage are: first=4 last=6 is THREE pages, 6-4+1, and first=4 last=4 is
# one page, not zero. Nothing along this path converts between conventions,
# because the only dependable way to avoid an off-by-one is never to change
# base or endpoint anywhere -- the header, the checks below, the Ghostscript
# command line and the page count reported back all mean the same thing by 4.
FIRST_PAGE="${FIRST_PAGE:-}"
LAST_PAGE="${LAST_PAGE:-}"
# Whether to announce the input's page count ahead of the document. Opt-in: a
# caller that did not ask must never find an extra line in front of its PDF,
# and a caller that did ask always gets exactly one.
REPORT="${REPORT:-}"

# Exit status, for a caller splitting one document into several print jobs:
#   0  the document, or the requested range of it, is on stdout
#   1  something unexpected went wrong
#   2  the header asked for something this script refuses
#   3  a range was requested and could not be produced. Nothing was written --
#      in particular the whole document was NOT written in its place
#   4  the range converted but is still larger than the printer will accept.
#      Nothing was written; a smaller range would help
# Only 0 ever writes a document. 3 and 4 both mean "ask again differently"; the
# difference is that 4 promises a smaller range would help and 3 does not.

# --selfcheck reports whether the Ghostscript on this machine is fit for the
# job. Ghostscript 10.02.1 -- Ubuntu 24.04's version -- discards function-based
# shadings, which is how browsers emit conic and repeating CSS gradients; 10.05
# and later keep them. Nothing needs to be configured either way, because every
# conversion is checked and one that lost something is discarded in favour of
# the original. This only tells you which of those two you are getting.
if [ "${1:-}" = "--selfcheck" ]; then
  probe="$(mktemp -t defont-probe-XXXXXX)"
  result="$(mktemp -t defont-result-XXXXXX)"
  trap 'rm -f "$probe" "$result"' EXIT
  base64 -d > "$probe" <<'PROBE_PDF'
JVBERi0xLjQKMSAwIG9iago8PCAvRnVuY3Rpb25UeXBlIDQgL0RvbWFpbiBbLTUwIDUwIC01MCA1
MF0gL1JhbmdlIFswIDEgMCAxIDAgMV0gL0xlbmd0aCA0MyA+PgpzdHJlYW0Ke2V4Y2ggYXRhbiAz
NjAgZGl2IGR1cCBkdXAgMSBleGNoIHN1YiAwLjI1fQplbmRzdHJlYW0KZW5kb2JqCjIgMCBvYmoK
PDwgL1R5cGUgL1BhdHRlcm4gL1BhdHRlcm5UeXBlIDIgL01hdHJpeCBbMSAwIDAgMSA2MCA2MF0g
L1NoYWRpbmcgPDwgL1NoYWRpbmdUeXBlIDEgL0RvbWFpbiBbLTUwIDUwIC01MCA1MF0gL0NvbG9y
U3BhY2UgL0RldmljZVJHQiAvRnVuY3Rpb24gMSAwIFIgPj4gPj4KZW5kb2JqCjMgMCBvYmoKPDwg
L0xlbmd0aCA0MiA+PgpzdHJlYW0KcSAvUGF0dGVybiBjcyAvUDAgc2NuIDEwIDEwIDEwMCAxMDAg
cmUgZiBRCmVuZHN0cmVhbQplbmRvYmoKNCAwIG9iago8PCAvVHlwZSAvUGFnZSAvUGFyZW50IDUg
MCBSIC9NZWRpYUJveCBbMCAwIDEyMCAxMjBdIC9SZXNvdXJjZXMgPDwgL1BhdHRlcm4gPDwgL1Aw
IDIgMCBSID4+ID4+IC9Db250ZW50cyAzIDAgUiA+PgplbmRvYmoKNSAwIG9iago8PCAvVHlwZSAv
UGFnZXMgL0tpZHMgWzQgMCBSXSAvQ291bnQgMSA+PgplbmRvYmoKNiAwIG9iago8PCAvVHlwZSAv
