PROBE_PDF
  echo "ghostscript: $("$GS" --version 2>/dev/null || echo 'NOT FOUND')"
  "$GS" -q -dNOPAUSE -dBATCH -dSAFER -dNoOutputFonts -sDEVICE=pdfwrite         -o "$result" "$probe" 2>/dev/null
  if LC_ALL=C grep -qa '/FunctionType' "$result"; then
    echo "function-based shadings: preserved"
    echo "verdict: fit. Every document is converted."
    exit 0
  fi
  echo "function-based shadings: DISCARDED"
  echo "verdict: affected. Documents using conic or repeating gradients are"
  echo "         relayed unconverted, so they keep their appearance but are"
  echo "         not protected against the font fault. Everything else is"
  echo "         converted normally. Ghostscript 10.05 or later fixes this;"
  echo "         Ubuntu 26.04 and Debian 13 both ship a new enough version."
  exit 1
fi

infile="$(mktemp -t defont-in-XXXXXX)"
outfile="$(mktemp -t defont-out-XXXXXX)"
trap 'rm -f "$infile" "$outfile" "${rasterfile:-}"' EXIT INT TERM QUIT HUP

if [ $# -ge 1 ] && [ "$1" != "-" ]; then
  cp -- "$1" "$infile"
else
  cat > "$infile"
fi

# The caller may prefix the document with one line describing what this
# particular printer accepts. It cannot be discovered here: this runs with no
# network, deliberately. Without the line the defaults above apply.
if [ "$(head -c 9 "$infile")" = '%%ippfix ' ]; then
  header="$(head -n 1 "$infile")"
  stripped="$(mktemp -t defont-hdr-XXXXXX)"
  tail -n +2 "$infile" > "$stripped"
  mv -f "$stripped" "$infile"
  # Validate every field. The header is written by the proxy, but this script
  # is also runnable by hand and a document could carry a line that looks like
  # one, so nothing from it is trusted. The device name in particular reaches a
  # Ghostscript command line, and Ghostscript has devices -- uniprint among
  # them -- that have been used to defeat -dSAFER; only the three raster
  # devices this tool actually emits are accepted.
  for field in ${header#%%ippfix }; do
    value="${field#*=}"
    case "$field" in
      device=appleraster|device=pclm|device=pclm8|device=pwgraster|device=urf)
                    RASTER_DEVICE="$value" ;;
      raster=none)  RASTER_DEVICE='' ;;
      # "Rasterise the input, do not outline it first." Spelled as its own
      # value of the field that already says which raster format to use, so
      # that the two statements about raster live in one place. Anything else
      # after raster= falls through to the unknown-field message below and
      # changes nothing, which is what a caller of a version that has never
      # heard of this asks for.
      raster=only)  RASTER_ONLY=1 ;;
      # The three values IPP defines, and nothing else. Spelled out one by one
      # rather than matched with a pattern for the same reason the device name
      # is: this value reaches a Ghostscript command line too, and a word
      # nobody has vetted must never get there. Everything that is not one of
      # these three is refused below, so no unknown spelling can turn into a
      # flag.
      sides=one-sided|sides=two-sided-long-edge|sides=two-sided-short-edge)
                    SIDES="$value" ;;
      colorspace=*) [ "$value" -ge 0 ] 2>/dev/null && [ "$value" -le 63 ] \
                      && RASTER_COLORSPACE="$value" ;;
      dpi=*)        [ "$value" -ge 72 ] 2>/dev/null && [ "$value" -le 2400 ] \
                      && RASTER_DPI="$value" ;;
      maxpdf=*)     [ "$value" -ge 0 ] 2>/dev/null && MAX_PDF_BYTES="$value" ;;
      # An endpoint that is present but empty is a caller that meant to say
      # something and failed. Reading it as "no range" would convert the whole
      # document in answer to a request for part of one, which is the failure
      # this whole path is built to avoid, so it is refused here where an
      # absent field and an empty one can still be told apart.
      first=|last=) echo "defont: refusing ${field}: no page number" >&2
                    exit 2 ;;
      # Ranges are only stashed here; they are checked below, where the check
      # can refuse the job outright instead of falling back to a default.
      first=*)      FIRST_PAGE="$value" ;;
      last=*)       LAST_PAGE="$value" ;;
      # Exactly one spelling turns the page count on. A caller that says
      # report=yes, or a later report=2 this version has never heard of, gets
      # today's behaviour -- a bare document -- rather than a line it does not
      # know it has to strip off the front of a PDF.
      report=1)     REPORT=1 ;;
      report=*)     echo "defont: ignoring report=${value};" \
                         "only report=1 asks for a page count" >&2 ;;
      device=*)     echo "defont: refusing unknown raster device ${value}" >&2 ;;
      # An unrecognised sides value degrades to the default -- no duplex flags
      # at all, which is what an absent field gives and what every job got
      # before this field existed -- rather than killing the job the way a bad
      # page range does. The two are not the same kind of mistake. A range has
      # no safe default: answering "pages 40-60" with the whole document prints
      # the entire job in the middle of itself, so there is nothing to fall
      # back to. Sides does have one, and it is the behaviour that has always
      # shipped. Exiting here instead would mean that the first caller to emit
      # an empty "sides=" for a client that never asked for duplex would stop
      # printing altogether, and a job that does not print at all is a worse
      # answer than the one this script has always given.
      #
      # It is not free, though: the default is simplex, so a proxy that garbles
      # this field prints one-sided while its IPP request says two. Hence the
      # message, which names the consequence rather than just the value, so
      # that it means something in a log read months later.
      sides=*)      echo "defont: refusing unknown sides=${value};" \
                         "the raster stream will keep saying one-sided" >&2 ;;
      *)            echo "defont: ignoring unknown header field ${field}" >&2 ;;
    esac
  done
fi

# raster=only and raster=none in the same header contradict each other, as does
# raster=only from a caller that never said which device to use on a build
# where the default was cleared. There is no raster to make, so the request
# degrades to the behaviour of a header that never mentioned it -- outlining --
# rather than killing a job that has a perfectly good answer.
if [ -n "$RASTER_ONLY" ] && [ -z "$RASTER_DEVICE" ]; then
  echo "defont: raster=only asked for but this printer accepts no raster" \
       "format; outlining instead" >&2
  RASTER_ONLY=''
fi

# Every other field falls back to its default when it makes no sense, which is
# safe because the default is what the document would have got had the field
# been absent. A page range cannot degrade that way: answering a request for
# pages 40-60 with the whole document would print the entire job in the place
# of one chunk of it, next to the other chunks. So a range this script cannot
# make sense of is fatal, and nothing at all is written.
for pair in "first=${FIRST_PAGE}" "last=${LAST_PAGE}"; do
  value="${pair#*=}"
  [ -n "$value" ] || continue          # absent, which is not the same as wrong
  # Digits only, tested with a glob rather than with [ -ge ]: this value ends
  # up on a Ghostscript command line, and the shell's idea of a number is wider
  # than -dFirstPage's. 0x10, +3, 1e2 and a stray space are caller bugs, not
  # things to interpret.
  case "$value" in
    *[!0-9]*)   echo "defont: refusing ${pair%%=*}=${value}:" \
                     "not a page number" >&2
                exit 2 ;;
  esac
  if [ "$value" -lt 1 ]; then
    echo "defont: refusing ${pair%%=*}=${value}: pages are numbered from 1" >&2
    exit 2
  fi
done
if [ -n "$FIRST_PAGE" ] && [ -n "$LAST_PAGE" ] \
   && [ "$LAST_PAGE" -lt "$FIRST_PAGE" ]; then
  echo "defont: refusing reversed range first=${FIRST_PAGE}" \
       "last=${LAST_PAGE}; both ends are inclusive, so last=first is the" \
       "smallest range there is" >&2
  exit 2
fi

# Where the document is to go. Taken once, here, because the fail-safe paths
# below run inside functions, where $2 is no longer the script's argument.
outarg="${2:--}"

# Ghostscript is not a lossless conduit, and when it loses something it does so
# quietly. Version 10.02.1 -- what Ubuntu 24.04 ships -- discards function-based
# shadings (/ShadingType 1 driven by a /FunctionType 4 calculator program),
# which is how browsers emit conic and repeating CSS gradients. The page still
# prints; the gradient is simply absent. That is precisely the silent wrongness
# this proxy must never introduce, so pinning a version is not enough: the
# result is checked instead, and any release with a comparable defect is caught
# by the same test. Ghostscript 10.05 and later handle these correctly;
# 10.02.1, which Ubuntu 24.04 ships, does not.
#
# The test is deliberately coarse -- whether a whole class of construct has
# vanished, not whether counts match. Ghostscript legitimately merges identical
# objects, so an exact count would raise false alarms; a class disappearing
# entirely is unambiguous.
# Look for a pattern anywhere in a PDF, including inside compressed object
# streams. Ghostscript 10.06 emits PDF 1.7 with object streams by default, so a
# plain grep no longer sees dictionaries that are certainly there -- and a
# safety check that silently stops finding what it is looking for is worse than
# no check at all.
pdfgrep() {   # $1 = file, $2 = python regex (bytes)
  python3 -c '
import re, sys, zlib
d = open(sys.argv[1], "rb").read()
pat = sys.argv[2].encode()
if re.search(pat, d):
    sys.exit(0)
for m in re.finditer(rb"/Type\s*/ObjStm.*?stream\r?\n", d, re.S):
    e = d.find(b"endstream", m.end())
    if e < 0:
        continue
    try:
        if re.search(pat, zlib.decompress(d[m.end():e].rstrip(b"\r\n"))):
            sys.exit(0)
    except Exception:
        pass
sys.exit(1)
' "$1" "$2" 2>/dev/null || LC_ALL=C grep -qa "$3" "$1"
}

marks() {
  python3 -c '
import re, sys, zlib
d = open(sys.argv[1], "rb").read()
seen = set()
def scan(b):
    seen.update(m.group(0) for m in
                re.finditer(rb"/(?:Shading|Pattern|Function)Type\s*\d+", b))
scan(d)
# Object streams hide these dictionaries from a plain scan, so expand any we find.
for m in re.finditer(rb"/Type\s*/ObjStm.*?stream\r?\n", d, re.S):
    e = d.find(b"endstream", m.end())
    if e < 0:
        continue
    try:
        scan(zlib.decompress(d[m.end():e].rstrip(b"\r\n")))
    except Exception:
        pass
print(b" ".join(sorted(x.replace(b" ", b"") for x in seen)).decode("latin1"))
' "$1" 2>/dev/null || LC_ALL=C grep -aoE '/(Shading|Pattern|Function)Type *[0-9]+' "$1" \
    | tr -d ' ' | sort -u | tr '\n' ' '
}

# How many pages a PDF has, according to Ghostscript rather than according to
# us. The caller uses this number to decide where to cut, so it has to be the
# same number Ghostscript counts against when it applies -dFirstPage and
# -dLastPage; counting /Type /Page ourselves agrees with that most of the time,
# which is the worst kind of agreement -- a document with pages inherited
# through the page tree, or one where the string turns up inside a stream,
# would be cut in the wrong place and nobody would find out until it printed.
#
# -dPDFINFO stays inside the hardened C PDF interpreter, so this costs no more
# trust than the conversion itself does. It prints "File has N pages", or
# "File has 1 page." for one. Nothing else in its output is parsed, and a file
# it cannot make sense of yields nothing at all, which the callers below treat
# as unknown rather than as zero.
pagecount() {   # $1 = file; echoes a decimal count, or nothing at all
  "$GS" -q -dNOPAUSE -dBATCH -dSAFER -dNODISPLAY -dPDFINFO "$1" 2>/dev/null \
    | sed -n 's/^[[:space:]]*File has \([0-9][0-9]*\) pages*\.*$/\1/p' \
    | head -n 1
}

# The page count goes to stdout even when the document goes to a file, so it
# can never end up inside a PDF. In the streaming case -- which is how the
# proxy calls this -- stdout is the document, so the line lands immediately in
# front of it, which is the contract: one line, then the body. Emitting it from
# here rather than at each exit is what guarantees it appears exactly once, and
# only on a path that really does produce a document.
reported=''
emit() {
  if [ -n "$REPORT" ] && [ -z "$reported" ]; then
    reported=1
    printf '%%%%ippfix-out pages=%s\n' "${INPUT_PAGES:-0}"
  fi
  if [ $# -ge 2 ] && [ "$2" != "-" ]; then
    cp -- "$1" "$2"
  else
    cat -- "$1"
  fi
}

# What "pass the input through" means depends on what was asked for. With no
# range it means the original document, which is a complete answer to the
# question that was asked. With a range it means nothing at all: the caller
# asked for pages 40-60 and will print whatever comes back alongside the other
# chunks, so handing it the whole document would print the entire job in the
# middle of itself. There is no safe substitute for a chunk, so the range case
# writes nothing and says why. The caller can still fall back to converting the
# document unsplit, which is exactly what it would have got before ranges
# existed.
fallback() {   # $1 = why, phrased to sit in the middle of a sentence
  if [ -n "$FIRST_PAGE$LAST_PAGE" ]; then
    echo "defont: $1; refusing to send the whole document in place of pages" \
         "${expect_first}-${expect_last}" >&2
    exit 3
  fi
  echo "defont: $1, passing input through" >&2
  emit "$infile" "$outarg"
  exit 0
}

# Ghostscript picks its interpreter from the start of the file: %PDF- at the
# beginning means the hardened C PDF interpreter, anything else means the full
# PostScript interpreter, where the historical -dSAFER escapes live. That
# choice must never rest with whoever sent the document, so only a file whose
# very first bytes are %PDF- is handed to gs. Everything else passes through
# untouched -- it contains no font programs we are being asked to remove.
if [ "$(head -c 5 "$infile")" != '%PDF-' ]; then
  # A range can only be taken from something that has pages. Reporting zero
  # says exactly that -- no document has zero pages -- so a caller can tell
  # "not splittable" from a count without having to guess at the body.
  if [ -n "$FIRST_PAGE$LAST_PAGE" ]; then
    echo "defont: pages ${FIRST_PAGE:-1}-${LAST_PAGE:-end} requested but the" \
         "input is not a PDF; nothing written" >&2
    exit 3
  fi
  INPUT_PAGES=0
  emit "$infile" "$outarg"
  exit 0
fi

# From here on the input is a PDF, so it can be counted. This is a second pass
# over the document, so it only happens when somebody asked for it.
expect_first=1
expect_last=''
expect_pages=0
if [ -n "$REPORT" ] || [ -n "$FIRST_PAGE$LAST_PAGE" ]; then
  INPUT_PAGES="$(pagecount "$infile")"
  if [ -z "$INPUT_PAGES" ]; then
    # A PDF Ghostscript will not count is a PDF we cannot cut safely. A bare
    # report=1 is still answerable: zero means "do not split this", which is as
    # true of a document that cannot be counted as it is of a raster job.
    if [ -n "$FIRST_PAGE$LAST_PAGE" ]; then
      echo "defont: cannot determine the page count; refusing to guess where" \
           "pages ${FIRST_PAGE:-1}-${LAST_PAGE:-end} are" >&2
      exit 3
    fi
    echo "defont: cannot determine the page count; reporting 0" >&2
    INPUT_PAGES=0
  fi
fi
if [ -n "$FIRST_PAGE$LAST_PAGE" ]; then
  if [ -n "$FIRST_PAGE" ] && [ "$FIRST_PAGE" -gt "$INPUT_PAGES" ]; then
    echo "defont: first=${FIRST_PAGE} is past the end of a ${INPUT_PAGES} page" \
         "document; nothing written" >&2
    exit 3
  fi
  if [ -n "$LAST_PAGE" ] && [ "$LAST_PAGE" -gt "$INPUT_PAGES" ]; then
    # Overshooting the end is how a caller says "and everything after it", and
    # Ghostscript stops at the last page regardless. Clamping here is what lets
    # the count check further down know how many pages to insist on.
    echo "defont: last=${LAST_PAGE} is past the end; using ${INPUT_PAGES}" >&2
    LAST_PAGE="$INPUT_PAGES"
  fi
  # Inclusive at both ends: 4..6 is three pages and 4..4 is one. That +1 is the
  # whole of the arithmetic, and it lives in exactly one place.
  expect_first="${FIRST_PAGE:-1}"
  expect_last="${LAST_PAGE:-$INPUT_PAGES}"
  expect_pages=$((expect_last - expect_first + 1))
fi

# Digits and nothing else, checked above, so these words cannot turn into
# anything but the two flags they look like.
range=()
if [ -n "$FIRST_PAGE" ]; then range+=(-dFirstPage="$FIRST_PAGE"); fi
if [ -n "$LAST_PAGE" ];  then range+=(-dLastPage="$LAST_PAGE");   fi

# What the page headers of the raster stream are to say about duplex.
#
# THE RASTER PATH ONLY. These flags are built here, beside the raster command
# line and nowhere near the pdfwrite one below, and they must never be added
# to it. On the PDF path the printer interprets the document itself and
# honours the IPP sides attribute in the normal way, so there is nothing to
# correct and nothing to say; a -dDuplex there would only stamp a page-device
# setting into a PDF that no printer reads back, while making it look as
# though the two paths were doing the same thing. The bug is specific to
# raster because only the raster stream carries a duplex field of its own,
# and that field wins over the attribute -- see the note on SIDES above for
# what that looked like on paper.
#
# Measured, not reasoned about. Ghostscript 10.06.0, -sDEVICE=appleraster, a
# two page input. The byte inspected is byte 2 of a 32 byte URF page header,
# which for the first page is file offset 14: eight bytes of "UNIRAST\0"
# magic, four bytes of page count, then the page header. Every page header in
# the stream carries the field, not just the first, and all of them changed
# together:
#
#   (no flags at all)             -> 1     one-sided
#   -dDuplex=false                -> 1     one-sided
#   -dDuplex=true -dTumble=false  -> 3     two-sided-long-edge
#   -dDuplex=true -dTumble=true   -> 2     two-sided-short-edge
#   -dTumble=true on its own      -> 1     Tumble does nothing without Duplex
#
# Which of 2 and 3 means which edge cannot be read off those numbers, so it
# was pinned against the one raster format that spells it out in words: the
# same flags given to -sDEVICE=pwgraster put Duplex=1/Tumble=0 in the CUPS
# page header for the case that yields 3, and Duplex=1/Tumble=1 for the case
# that yields 2. CUPS's Tumble is the PPD's DuplexTumble, which is short edge
# binding. So 3 is long edge and 2 is short edge, which is also what the URF
# specification says. Anybody re-checking this has no printer to hand either,
# so check it the same way: the self-test asserts these exact bytes.
#
# -dTumble is stated explicitly in the long edge case rather than left to its
# default, because the point of this whole change is that a default nobody
# wrote down was the bug.
#
# The flags are not URF-specific and are safe for every device this script
# will emit: appleraster, urf, pwgraster, pclm and pclm8 all accept them and
# all still produce output. pwgraster records them in its CUPS page header as
# above; the two PCLm devices at least act on them. Only the URF numbers were
# pinned to paper, because URF is the format the affected printer takes.
duplex=()
case "$SIDES" in
  one-sided)            duplex=(-dDuplex=false) ;;
  two-sided-long-edge)  duplex=(-dDuplex=true -dTumble=false) ;;
  two-sided-short-edge) duplex=(-dDuplex=true -dTumble=true) ;;
  # Absent, or refused during header parsing. Nothing at all is passed, so
  # the stream is byte for byte what this script produced before the field
  # existed -- which is what makes an unrecognised value harmless.
esac

# Rasterise from the ORIGINAL, not the outlined copy: the outlines are a
# detour, and going straight from the source keeps one interpretation step.
# The range applies here too. Rasterising the whole document in answer to a
# request for one page of it would be the same mistake as passing the whole
# input through, only harder to notice.
#
# Both callers want the same command line, and there is exactly one place it
# can be written without the two drifting apart.
rasterise() {   # fills "$rasterfile"; non-zero means nothing usable came back
  rasterfile="$(mktemp -t defont-raster-XXXXXX)"
  "$GS" -q -dNOPAUSE -dBATCH -dSAFER -K400000 \
        "${range[@]}" "${duplex[@]}" \
        -sDEVICE="$RASTER_DEVICE" -r"$RASTER_DPI" \
        -dcupsColorSpace="$RASTER_COLORSPACE" -dcupsBitsPerColor=8 \
        -sOutputFile="$rasterfile" "$infile" >&2 && [ -s "$rasterfile" ]
}

# raster=only: the caller wants the raster and not the outlined PDF, which is
# what a printer that has already refused the PDF is asked for again. It
# happens here, before the pdfwrite pass, because there is nothing for that
# pass to contribute -- the raster comes from the input either way -- and
# because the fail-safes that follow it would all answer with the very PDF the
# caller is trying to replace. Rasterising that cannot be done leaves the same
# answer as before this field existed: the input, passed through, which the
# caller can tell apart from a raster by looking at it.
#
# A range is passed to Ghostscript here as it is anywhere else, but the check
# that the right NUMBER of pages came back cannot run on this path: nothing
# here counts the pages in a raster stream, and counting them would mean
# parsing one. The proxy never asks for both at once -- it asks for a range
# only by hand, for diagnosis -- so this is a limit of the diagnostic path and
# is written down rather than guarded.
if [ -n "$RASTER_ONLY" ]; then
  if rasterise; then
    emit "$rasterfile" "$outarg"
    rm -f "$rasterfile"
    exit 0
  fi
  rm -f "$rasterfile"
  fallback "rasterising failed"
fi

# -dNoOutputFonts does the work. The remaining options exist to make sure
# nothing else is quietly degraded on the way through: image downsampling in
# particular is on by default in Ghostscript's named presets, which would throw
# away half the usable resolution on a 600 dpi engine.
"$GS" -q -dNOPAUSE -dBATCH -dSAFER \
      -K400000 \
      -dNoOutputFonts \
      "${range[@]}" \
      -sDEVICE=pdfwrite \
      -dCompatibilityLevel=1.4 \
      -dAutoRotatePages=/None \
      -dDownsampleColorImages=false \
      -dDownsampleGrayImages=false \
      -dDownsampleMonoImages=false \
      -dAutoFilterColorImages=false \
      -dAutoFilterGrayImages=false \
      -dPassThroughJPEGImages=true \
      -dColorConversionStrategy=/LeaveColorUnchanged \
      -sOutputFile="$outfile" "$infile" >&2

# Fail safe. A job that might not print is better than one that prints wrongly,
# so anything unexpected falls back to the original bytes.
if [ ! -s "$outfile" ]; then
  fallback "empty output"
fi

# A range that selects nothing does not produce an empty file. Ghostscript
# writes a perfectly valid PDF holding one blank page, which every other check
# here is happy with and which would print as a blank sheet in the middle of
# the document. So the number of pages that came out is compared with the
# number that was asked for, and anything else is a failure rather than
# something to send.
if [ -n "$FIRST_PAGE$LAST_PAGE" ]; then
  got="$(pagecount "$outfile")"
  if [ "$got" != "$expect_pages" ]; then
    echo "defont: asked for pages ${expect_first}-${expect_last}," \
         "${expect_pages} of them, but the conversion produced" \
         "${got:-an uncountable number}; nothing written" >&2
    exit 3
  fi
fi

if pdfgrep "$outfile" '/FontFile' '/FontFile'; then
  fallback "font programs survived"
fi

# Every class of drawing construct in the input must survive into the output.
lost=''
before="$(marks "$infile")"
after="$(marks "$outfile")"
for m in $before; do
  case " $after " in
    *" $m "*) ;;
    *) lost="$lost $m" ;;
  esac
done
if [ -n "$lost" ]; then
  # In range mode this comparison is left deliberately too strict. The input is
  # scanned whole while the output holds only the requested pages, so a class
  # that lives on a page outside the range reads as lost. Narrowing the scan to
  # the range would mean parsing the page tree here, and parsing PDFs anywhere
  # but inside Ghostscript is what this script exists to avoid; narrowing it by
  # running the input through Ghostscript first would lose exactly what is
  # being looked for. So the false alarm stays, and it fails the chunk instead
  # of sending it -- the caller's answer to a chunk it cannot have is to
  # convert the document unsplit, which is what it did before ranges existed.
  if [ -z "$FIRST_PAGE$LAST_PAGE" ]; then
    echo "defont: Ghostscript before 10.05 discards function-based shadings," \
         "which is how browsers emit conic and repeating gradients; upgrading" \
         "it restores the fix for these documents." >&2
  else
    echo "defont:${lost} may only ever have been on a page outside" \
         "${expect_first}-${expect_last}, which this check cannot tell apart" \
         "from a real loss. Convert the document unsplit to find out." >&2
  fi
  fallback "conversion dropped${lost}"
fi

# Fall back to raster only when the outlined PDF is too large to be accepted.
outsize="$(stat -c%s "$outfile")"

# A range that is still too big is the caller's problem to solve, not ours.
# Rasterising it here would work, but it would change how one chunk in the
# middle of a document looks while its neighbours stayed vector, and the caller
# -- which is choosing the chunk sizes and can simply choose smaller ones --
# would never learn that it happened. So say so and refuse. A single page is
# the one case where there is nothing left to cut, and there rasterising is the
# only thing left that prints at all, so it happens, loudly.
if [ -n "$FIRST_PAGE$LAST_PAGE" ] && [ "$expect_pages" -gt 1 ] \
   && [ "$outsize" -gt "$MAX_PDF_BYTES" ]; then
  echo "defont: pages ${expect_first}-${expect_last} outlined to ${outsize}" \
       "bytes, over ${MAX_PDF_BYTES}; nothing written. Ask again for a" \
       "smaller range" >&2
  exit 4
fi
if [ "$expect_pages" = 1 ] && [ "$outsize" -gt "$MAX_PDF_BYTES" ] \
   && [ -n "$RASTER_DEVICE" ]; then
  echo "defont: page ${expect_first} on its own is over ${MAX_PDF_BYTES}" \
       "outlined, so it comes back as raster while the rest of the document" \
       "is vector. It will not look quite like its neighbours" >&2
fi

if [ "$outsize" -gt "$MAX_PDF_BYTES" ] && [ -n "$RASTER_DEVICE" ]; then
  echo "defont: outlined output ${outsize} bytes exceeds ${MAX_PDF_BYTES};" \
       "rasterising instead" >&2
  if rasterise; then
    emit "$rasterfile" "$outarg"
    rm -f "$rasterfile"
    exit 0
  fi
  echo "defont: rasterising failed; sending the outlined PDF anyway" >&2
  rm -f "$rasterfile"
elif [ "$outsize" -gt "$MAX_PDF_BYTES" ]; then
  echo "defont: outlined output ${outsize} bytes exceeds ${MAX_PDF_BYTES} but" \
       "this printer accepts no raster format; sending it anyway" >&2
fi

emit "$outfile" "$outarg"
