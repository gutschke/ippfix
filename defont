  echo "ghostscript: $("$GS" --version 2>/dev/null || echo 'NOT FOUND')"
  "$GS" -q -dNOPAUSE -dBATCH -dSAFER -dNoOutputFonts -sDEVICE=pdfwrite         -o "$result" "$probe" 2>/dev/null
  if LC_ALL=C grep -qa '/FunctionType' "$result"; then
    echo "function-based shadings: preserved"
    echo "verdict: fit. Every document is converted."
    exit 0
  fi
  echo "function-based shadings: DISCARDED"
  echo "verdict: affected. Documents using conic or repeating gradients are"
  echo "         relayed unconverted, so they keep their appearance but are"
  echo "         not protected against the font fault. Everything else is"
  echo "         converted normally. Ghostscript 10.05 or later fixes this;"
  echo "         Ubuntu 26.04 and Debian 13 both ship a new enough version."
  exit 1
fi

infile="$(mktemp -t defont-in-XXXXXX)"
outfile="$(mktemp -t defont-out-XXXXXX)"
trap 'rm -f "$infile" "$outfile" "${rasterfile:-}"' EXIT INT TERM QUIT HUP

if [ $# -ge 1 ] && [ "$1" != "-" ]; then
  cp -- "$1" "$infile"
else
  cat > "$infile"
fi

# The caller may prefix the document with one line describing what this
# particular printer accepts. It cannot be discovered here: this runs with no
# network, deliberately. Without the line the defaults above apply.
if [ "$(head -c 9 "$infile")" = '%%ippfix ' ]; then
  header="$(head -n 1 "$infile")"
  stripped="$(mktemp -t defont-hdr-XXXXXX)"
  tail -n +2 "$infile" > "$stripped"
  mv -f "$stripped" "$infile"
  # Validate every field. The header is written by the proxy, but this script
  # is also runnable by hand and a document could carry a line that looks like
  # one, so nothing from it is trusted. The device name in particular reaches a
  # Ghostscript command line, and Ghostscript has devices -- uniprint among
  # them -- that have been used to defeat -dSAFER; only the three raster
  # devices this tool actually emits are accepted.
  for field in ${header#%%ippfix }; do
    value="${field#*=}"
    case "$field" in
      device=appleraster|device=pclm|device=pclm8|device=pwgraster|device=urf)
                    RASTER_DEVICE="$value" ;;
      raster=none)  RASTER_DEVICE='' ;;
      colorspace=*) [ "$value" -ge 0 ] 2>/dev/null && [ "$value" -le 63 ] \
                      && RASTER_COLORSPACE="$value" ;;
      dpi=*)        [ "$value" -ge 72 ] 2>/dev/null && [ "$value" -le 2400 ] \
                      && RASTER_DPI="$value" ;;
      maxpdf=*)     [ "$value" -ge 0 ] 2>/dev/null && MAX_PDF_BYTES="$value" ;;
      device=*)     echo "defont: refusing unknown raster device ${value}" >&2 ;;
      *)            echo "defont: ignoring unknown header field ${field}" >&2 ;;
    esac
  done
fi

# Ghostscript is not a lossless conduit, and when it loses something it does so
# quietly. Version 10.02.1 -- what Ubuntu 24.04 ships -- discards function-based
# shadings (/ShadingType 1 driven by a /FunctionType 4 calculator program),
# which is how browsers emit conic and repeating CSS gradients. The page still
# prints; the gradient is simply absent. That is precisely the silent wrongness
# this proxy must never introduce, so pinning a version is not enough: the
# result is checked instead, and any release with a comparable defect is caught
# by the same test. Ghostscript 10.07.1 handles these correctly.
#
# The test is deliberately coarse -- whether a whole class of construct has
# vanished, not whether counts match. Ghostscript legitimately merges identical
# objects, so an exact count would raise false alarms; a class disappearing
# entirely is unambiguous.
marks() {
  python3 -c '
import re, sys, zlib
d = open(sys.argv[1], "rb").read()
seen = set()
def scan(b):
    seen.update(m.group(0) for m in
                re.finditer(rb"/(?:Shading|Pattern|Function)Type\s*\d+", b))
scan(d)
# Object streams hide these dictionaries from a plain scan, so expand any we find.
for m in re.finditer(rb"/Type\s*/ObjStm.*?stream\r?\n", d, re.S):
    e = d.find(b"endstream", m.end())
    if e < 0:
        continue
    try:
        scan(zlib.decompress(d[m.end():e].rstrip(b"\r\n")))
    except Exception:
        pass
print(b" ".join(sorted(x.replace(b" ", b"") for x in seen)).decode("latin1"))
' "$1" 2>/dev/null || LC_ALL=C grep -aoE '/(Shading|Pattern|Function)Type *[0-9]+' "$1" \
    | tr -d ' ' | sort -u | tr '\n' ' '
}

emit() {
  if [ $# -ge 2 ] && [ "$2" != "-" ]; then
    cp -- "$1" "$2"
  else
    cat -- "$1"
  fi
}

# Ghostscript picks its interpreter from the start of the file: %PDF- at the
# beginning means the hardened C PDF interpreter, anything else means the full
# PostScript interpreter, where the historical -dSAFER escapes live. That
# choice must never rest with whoever sent the document, so only a file whose
# very first bytes are %PDF- is handed to gs. Everything else passes through
# untouched -- it contains no font programs we are being asked to remove.
if [ "$(head -c 5 "$infile")" != '%PDF-' ]; then
  emit "$infile" "${2:--}"
  exit 0
fi

# -dNoOutputFonts does the work. The remaining options exist to make sure
# nothing else is quietly degraded on the way through: image downsampling in
# particular is on by default in Ghostscript's named presets, which would throw
# away half the usable resolution on a 600 dpi engine.
"$GS" -q -dNOPAUSE -dBATCH -dSAFER \
      -K400000 \
      -dNoOutputFonts \
      -sDEVICE=pdfwrite \
      -dCompatibilityLevel=1.4 \
      -dAutoRotatePages=/None \
      -dDownsampleColorImages=false \
      -dDownsampleGrayImages=false \
      -dDownsampleMonoImages=false \
      -dAutoFilterColorImages=false \
      -dAutoFilterGrayImages=false \
      -dPassThroughJPEGImages=true \
      -dColorConversionStrategy=/LeaveColorUnchanged \
      -sOutputFile="$outfile" "$infile" >&2

# Fail safe. A job that might not print is better than one that prints wrongly,
# so anything unexpected falls back to the original bytes.
if [ ! -s "$outfile" ]; then
  echo "defont: empty output, passing input through" >&2
  emit "$infile" "${2:--}"
  exit 0
fi
if grep -qa '/FontFile' "$outfile"; then
  echo "defont: font programs survived, passing input through" >&2
  emit "$infile" "${2:--}"
  exit 0
fi

# Every class of drawing construct in the input must survive into the output.
lost=''
before="$(marks "$infile")"
after="$(marks "$outfile")"
for m in $before; do
  case " $after " in
    *" $m "*) ;;
    *) lost="$lost $m" ;;
  esac
done
if [ -n "$lost" ]; then
  echo "defont: conversion dropped${lost}; passing input through." \
       "Ghostscript before 10.07 discards function-based shadings, which is" \
       "how browsers emit conic and repeating gradients; upgrading it restores" \
       "the fix for these documents." >&2
  emit "$infile" "${2:--}"
  exit 0
fi

# Fall back to raster only when the outlined PDF is too large to be accepted.
outsize="$(stat -c%s "$outfile")"
if [ "$outsize" -gt "$MAX_PDF_BYTES" ] && [ -n "$RASTER_DEVICE" ]; then
  echo "defont: outlined output ${outsize} bytes exceeds ${MAX_PDF_BYTES};" \
       "rasterising instead" >&2
  rasterfile="$(mktemp -t defont-raster-XXXXXX)"
  # Rasterise from the ORIGINAL, not the outlined copy: the outlines are a
  # detour, and going straight from the source keeps one interpretation step.
  if "$GS" -q -dNOPAUSE -dBATCH -dSAFER -K400000 \
        -sDEVICE="$RASTER_DEVICE" -r"$RASTER_DPI" \
        -dcupsColorSpace="$RASTER_COLORSPACE" -dcupsBitsPerColor=8 \
        -sOutputFile="$rasterfile" "$infile" >&2 && [ -s "$rasterfile" ]; then
    emit "$rasterfile" "${2:--}"
    rm -f "$rasterfile"
    exit 0
  fi
  echo "defont: rasterising failed; sending the outlined PDF anyway" >&2
  rm -f "$rasterfile"
elif [ "$outsize" -gt "$MAX_PDF_BYTES" ]; then
  echo "defont: outlined output ${outsize} bytes exceeds ${MAX_PDF_BYTES} but" \
       "this printer accepts no raster format; sending it anyway" >&2
fi

emit "$outfile" "${2:--}"
