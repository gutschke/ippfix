#!/bin/bash -e
#
# defont: rewrite a PDF so that it contains no embedded font programs.
#
# Ghostscript's -dNoOutputFonts converts every glyph to a filled path. The text
# stays vector, so the printer's own rasteriser still renders it at full device
# precision and edge enhancement still applies; only the font programs, and the
# interpreter's need to cache them, go away.
#
# Reads a PDF on stdin and writes one on stdout. Input that is not a PDF is
# passed through untouched, so raster and PCL jobs are unaffected.
#
export LC_ALL=C
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH}"

GS="${GS:-gs}"

# Outlining a page inlines a full outline at every glyph occurrence, so a long
# document can grow past what the printer will accept as a PDF at all -- HP
# LaserJet Pro devices advertise pdf-k-octets-supported of 0-75000. Past this
# size the page is rasterised instead: lower fidelity, but it prints, and a
# job that prints imperfectly beats one the printer rejects outright.
MAX_PDF_BYTES="${MAX_PDF_BYTES:-60000000}"
RASTER_DPI="${RASTER_DPI:-600}"
# 19 = SRGB24, the colour space these printers advertise first. 18 is W8 grey,
# which halves the size and avoids composite-black fringing on text.
RASTER_COLORSPACE="${RASTER_COLORSPACE:-19}"

infile="$(mktemp -t defont-in-XXXXXX)"
outfile="$(mktemp -t defont-out-XXXXXX)"
trap 'rm -f "$infile" "$outfile" "${rasterfile:-}"' EXIT INT TERM QUIT HUP

if [ $# -ge 1 ] && [ "$1" != "-" ]; then
  cp -- "$1" "$infile"
else
  cat > "$infile"
fi

emit() {
  if [ $# -ge 2 ] && [ "$2" != "-" ]; then
    cp -- "$1" "$2"
  else
    cat -- "$1"
  fi
}

# Ghostscript picks its interpreter from the start of the file: %PDF- at the
# beginning means the hardened C PDF interpreter, anything else means the full
# PostScript interpreter, where the historical -dSAFER escapes live. That
# choice must never rest with whoever sent the document, so only a file whose
# very first bytes are %PDF- is handed to gs. Everything else passes through
# untouched -- it contains no font programs we are being asked to remove.
if [ "$(head -c 5 "$infile")" != '%PDF-' ]; then
  emit "$infile" "${2:--}"
  exit 0
fi

# -dNoOutputFonts does the work. The remaining options exist to make sure
# nothing else is quietly degraded on the way through: image downsampling in
# particular is on by default in Ghostscript's named presets, which would throw
# away half the usable resolution on a 600 dpi engine.
"$GS" -q -dNOPAUSE -dBATCH -dSAFER \
      -K400000 \
      -dNoOutputFonts \
      -sDEVICE=pdfwrite \
      -dCompatibilityLevel=1.4 \
      -dAutoRotatePages=/None \
      -dDownsampleColorImages=false \
      -dDownsampleGrayImages=false \
      -dDownsampleMonoImages=false \
      -dAutoFilterColorImages=false \
      -dAutoFilterGrayImages=false \
      -dPassThroughJPEGImages=true \
      -dColorConversionStrategy=/LeaveColorUnchanged \
      -sOutputFile="$outfile" "$infile" >&2

# Fail safe. A job that might not print is better than one that prints wrongly,
# so anything unexpected falls back to the original bytes.
if [ ! -s "$outfile" ]; then
  echo "defont: empty output, passing input through" >&2
  emit "$infile" "${2:--}"
  exit 0
fi
if grep -qa '/FontFile' "$outfile"; then
  echo "defont: font programs survived, passing input through" >&2
  emit "$infile" "${2:--}"
  exit 0
fi

# Fall back to raster only when the outlined PDF is too large to be accepted.
outsize="$(stat -c%s "$outfile")"
if [ "$outsize" -gt "$MAX_PDF_BYTES" ]; then
  echo "defont: outlined output ${outsize} bytes exceeds ${MAX_PDF_BYTES};" \
       "rasterising instead" >&2
  rasterfile="$(mktemp -t defont-raster-XXXXXX)"
  # Rasterise from the ORIGINAL, not the outlined copy: the outlines are a
  # detour, and going straight from the source keeps one interpretation step.
  if "$GS" -q -dNOPAUSE -dBATCH -dSAFER -K400000 \
        -sDEVICE=appleraster -r"$RASTER_DPI" \
        -dcupsColorSpace="$RASTER_COLORSPACE" -dcupsBitsPerColor=8 \
        -sOutputFile="$rasterfile" "$infile" >&2 && [ -s "$rasterfile" ]; then
    emit "$rasterfile" "${2:--}"
    rm -f "$rasterfile"
    exit 0
  fi
  echo "defont: rasterising failed; sending the outlined PDF anyway" >&2
  rm -f "$rasterfile"
fi

emit "$outfile" "${2:--}"
