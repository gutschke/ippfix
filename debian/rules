#!/usr/bin/make -f
# The upstream tree installs itself into /usr/local with a shell script. The
# package puts the same files under /usr/lib and drives the configuration from
# a conffile instead of from the unit, so the units are rewritten here rather
# than duplicated -- one source of truth, and the differences stay visible.
LIB := /usr/lib/ippfix

%:
	dh $@

override_dh_auto_build:
override_dh_auto_test:

override_dh_auto_install:
	# Program files.
	install -d debian/ippfix$(LIB)
	install -m0644 ippfix.py ippcodec.py debian/ippfix$(LIB)/
	install -m0755 defont ippfix debian/ippfix$(LIB)/
	install -m0755 debian/pkg/ippfix-setup debian/pkg/ippfix-configured \
		debian/pkg/ippfix-sendalert debian/ippfix$(LIB)/
	install -d debian/ippfix/usr/bin
	# Relative, and relative to /usr/bin -- not to the root. '..$(LIB)' would
	# resolve to /usr/usr/lib/ippfix and dangle.
	ln -sf ../lib/ippfix/ippfix debian/ippfix/usr/bin/ippfix

	# The configuration is NOT shipped. The package cannot know which printers
	# exist, and a file that always exists cannot tell systemd whether the
	# machine has been set up -- so an example is installed instead and the units
	# are conditional on the real one appearing. Same arrangement as splitdnsd.
	install -D -m0644 debian/pkg/ippfix.conf \
		debian/ippfix/usr/share/doc/ippfix/ippfix.conf.example

	# Units, with the install path corrected and the command line moved out of
	# ExecStart into the conffile.
	install -d debian/ippfix/usr/lib/systemd/system
	for u in ippfix-convert.socket ippfix-convert@.service; do \
	  sed -e 's#/usr/local/lib/ippfix#$(LIB)#g' "$$u" \
	      > debian/ippfix/usr/lib/systemd/system/"$$u"; \
	done
	install -m0644 debian/pkg/ippfix.service debian/pkg/ippfix.socket \
		debian/pkg/ippfix-alert.path debian/pkg/ippfix-alert.service \
		debian/ippfix/usr/lib/systemd/system/
	# Users and directories come from debian/ippfix.{sysusers,tmpfiles};
	# debhelper installs them and adds the snippets that apply them.

	# --- ippfix-selfbuild ---------------------------------------------------
	install -d debian/ippfix-selfbuild/usr/lib/ippfix-selfbuild
	install -m0755 debian/pkg/selfbuild/ippfix-autobuild \
		debian/pkg/selfbuild/autobuild-notify \
		debian/ippfix-selfbuild/usr/lib/ippfix-selfbuild/
	install -d debian/ippfix-selfbuild/usr/lib/systemd/system
	install -m0644 debian/pkg/selfbuild/ippfix-selfbuild.service \
		debian/pkg/selfbuild/ippfix-selfbuild.timer \
		debian/pkg/selfbuild/ippfix-selfbuild-notify@.service \
		debian/ippfix-selfbuild/usr/lib/systemd/system/
	install -D -m0644 debian/pkg/selfbuild/80ippfix-selfbuild \
		debian/ippfix-selfbuild/etc/apt/apt.conf.d/80ippfix-selfbuild

	# Diagnostics worth having on the machine that has the problem.
	install -d debian/ippfix/usr/share/ippfix/scripts
	install -m0755 scripts/*.py debian/ippfix/usr/share/ippfix/scripts/

# dh_installsysusers is not in this debhelper's default sequence, so it is
# invoked alongside the helper that is. Without it the accounts the units run
# as would simply never be created.
override_dh_installtmpfiles:
	dh_installtmpfiles
	dh_installsysusers

override_dh_installsystemd:
	# The proxy's sockets are enabled; the service itself is socket-activated
	# and, in any case, does nothing until a printer is configured.
	# Sockets are not restarted on upgrade. A listening socket cannot rebind
	# while the service still holds its descriptor, so the restart returns
	# non-zero and dpkg prints a failure that is not one. There is nothing to
	# gain either: the service restarts and re-inherits the same descriptor.
	dh_installsystemd -pippfix --name=ippfix-convert --no-restart-after-upgrade \
		ippfix-convert.socket
	dh_installsystemd -pippfix --no-restart-after-upgrade ippfix.socket
	# Enabled, not merely socket-activated. The daemon has to be running to
	# publish the queue over DNS-SD, and a client cannot connect to something it
	# cannot discover -- so leaving it to start on the first connection means it
	# never starts at all after a reboot. Starting a freshly installed,
	# unconfigured one is harmless: ExecCondition= skips it and it stays inactive
	# rather than failing.
	dh_installsystemd -pippfix ippfix.service
	# The path unit watches for queued alerts; its service is triggered, never
	# enabled on its own.
	dh_installsystemd -pippfix --name=ippfix-alert ippfix-alert.path
	dh_installsystemd -pippfix --name=ippfix-alert --no-enable --no-start \
		ippfix-alert.service
	# Only the timer is enabled for the self-build; the oneshot service is
	# started by the apt hook and by the timer, never on its own.
	dh_installsystemd -pippfix-selfbuild --no-start ippfix-selfbuild.timer
	dh_installsystemd -pippfix-selfbuild --no-enable --no-start \
		ippfix-selfbuild.service ippfix-selfbuild-notify@.service

override_dh_installman:
	dh_installman -pippfix ippfix.8
