# Archived jobs are a diagnostic, not a record. --archive-max bounds how many
# are kept; this ages them out as well, so a forgotten flag cannot leave
# documents on disk indefinitely.
d /var/lib/ippfix       0700 ippfix ippfix -
d /var/lib/ippfix/archive 0700 ippfix ippfix 7d

# Conversion runs with PrivateTmp, so its scratch files die with the instance.
# This only catches anything left by a run started outside systemd.
d /run/ippfix           0755 ippfix ippfix -

# Configuration, owned by the daemon so it can read its own TLS key.
d /etc/ippfix 0750 ippfix ippfix -

# Queued failure reports. The proxy writes here; ippfix-alert delivers and
# removes them. Aged out so an undeliverable one cannot accumulate.
d /var/lib/ippfix/alerts 0700 ippfix ippfix 7d
