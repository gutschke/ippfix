#!/bin/sh
set -e

case "$1" in
  remove|purge)
    # Built at install time, so it is ours to remove; dpkg does not know about
    # the files inside it.
    rm -rf /usr/lib/ippfix/venv
    ;;
esac

case "$1" in
  purge)
    # Generated, not shipped: the TLS credentials and anything archived.
    rm -f /etc/ippfix/ippfix.key /etc/ippfix/ippfix.crt
    # Generated by 'ippfix-archive-reminder --schedule'. It removes itself once
    # it has run, but a package purged before that day would strand it pointing
    # at a program that is no longer installed.
    if [ -e /etc/systemd/system/ippfix-archive-reminder.timer ]; then
      systemctl disable --now ippfix-archive-reminder.timer >/dev/null 2>&1 || :
      rm -f /etc/systemd/system/ippfix-archive-reminder.timer \
            /etc/systemd/system/ippfix-archive-reminder.service
      systemctl daemon-reload >/dev/null 2>&1 || :
    fi
    rm -rf /var/lib/ippfix
    rmdir /etc/ippfix 2>/dev/null || true
    rmdir /usr/lib/ippfix 2>/dev/null || true
    ;;
esac

#DEBHELPER#
exit 0
