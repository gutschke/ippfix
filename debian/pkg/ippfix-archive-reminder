#!/bin/sh
# Remind an administrator to turn --archive off again, then remove itself.
#
# --archive writes the documents people print to disk. It exists because the
# fault this proxy works around is silent and content dependent, so without the
# document that provoked it there is nothing to look at -- but that makes it a
# diagnostic with an expiry date, and a diagnostic left on is a disclosure
# waiting to happen. Nobody remembers a flag they turned on three months ago.
#
# So: schedule a reminder, and let the reminder clean up after itself. Turning
# --archive off is then the only thing left to do by hand, which is the only
# thing that actually needs judgement.
#
#     ippfix-archive-reminder --schedule 2026-11-24 [ADDRESS]
#     ippfix-archive-reminder --cancel
#
# With no arguments it does the reminding, which is how the timer runs it.
set -u

UNITS=/etc/systemd/system
SERVICE="$UNITS/ippfix-archive-reminder.service"
TIMER="$UNITS/ippfix-archive-reminder.timer"
CONF=${IPPFIX_CONF:-/etc/ippfix/ippfix.conf}
SPOOL=${IPPFIX_ALERT_SPOOL:-/var/lib/ippfix/alerts}
# Absolute path to this script, so a generated unit points at it wherever it
# was installed -- /usr/lib/ippfix from the package, /usr/local/lib/ippfix or
# /opt from install.sh.
case "$0" in
    /*) SELF=$0 ;;
    *)  SELF=$(cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0") ;;
esac

# Everything this leaves behind, in one list, so that removing it is one loop
# and cannot drift out of step with what scheduling created.
remove_self() {
    systemctl disable --now ippfix-archive-reminder.timer >/dev/null 2>&1 || :
    rm -f "$TIMER" "$SERVICE"
    systemctl daemon-reload >/dev/null 2>&1 || :
}

# Comment lines are dropped first. The shipped example configuration documents
# --archive in a comment, and matching that would report the flag as on, with
# the directory named "DIR", on every machine that had never enabled it.
extract_opt() {
    grep -v '^[[:space:]]*#' \
    | sed -n "s/.*$1[= ]\{1,\}\([^ '\"]\{1,\}\).*/\1/p" | head -1
}

extract_archive() { extract_opt -\-archive; }

archive_dir() {
    # Where --archive is writing, if anywhere. The running process is asked
    # first because it is the only source that cannot be stale: a conffile
    # edited but not yet applied says the flag is off while documents are still
    # being written. Falling back to the files matters for the layout that has
    # no conffile at all, where the command line lives in the unit.
    pid=$(systemctl show -p MainPID --value ippfix.service 2>/dev/null)
    if [ -n "${pid:-}" ] && [ "$pid" != 0 ] && [ -r "/proc/$pid/cmdline" ]; then
        dir=$(tr '\0' ' ' < "/proc/$pid/cmdline" | extract_archive)
        [ -z "$dir" ] || { printf '%s\n' "$dir"; return 0; }
        # A running daemon that was asked and said no is authoritative.
        return 1
    fi
    [ ! -r "$CONF" ] || dir=$(extract_archive < "$CONF")
    [ -n "${dir:-}" ] || dir=$(systemctl cat ippfix.service 2>/dev/null \
                               | extract_archive)
    [ -n "${dir:-}" ] || return 1
    printf '%s\n' "$dir"
}

case "${1-}" in
--schedule)
    when=${2-}
    [ -n "$when" ] || { echo "usage: $0 --schedule YYYY-MM-DD [ADDRESS]" >&2
                        exit 2; }
    to=${3-}
    if [ -z "$to" ] && [ -r "$CONF" ]; then
        to=$(extract_opt -\-alert-mail < "$CONF")
    fi
    [ -n "$to" ] || { echo "$0: no address given and none in $CONF" >&2
                      exit 2; }
    cat > "$SERVICE" <<UNIT
[Unit]
Description=Remind that ippfix --archive is still on
Documentation=man:ippfix(8)
# Generated by $SELF --schedule. It deletes this file when it has run; there is
# nothing here to maintain and nothing to remove by hand.

[Service]
Type=oneshot
Environment=IPPFIX_REMINDER_TO=$to
Environment=IPPFIX_REMINDER_SINCE=$(date +%Y-%m-%d)
ExecStart=$SELF
UNIT
    cat > "$TIMER" <<UNIT
[Unit]
Description=Remind that ippfix --archive is still on
Documentation=man:ippfix(8)
# Generated by $SELF --schedule.

[Timer]
OnCalendar=$when 09:00:00
# Fire on the next boot if the machine was off on the day, rather than
# skipping a reminder that exists precisely because it is easy to forget.
Persistent=true
AccuracySec=1h

[Install]
WantedBy=timers.target
UNIT
    systemctl daemon-reload
    systemctl enable --now ippfix-archive-reminder.timer
    echo "will remind $to on $when, then remove itself"
    exit 0
    ;;
--cancel)
    remove_self
    echo "reminder removed"
    exit 0
    ;;
--help|-h)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
"")
    ;;
*)
    echo "$0: unknown argument $1" >&2
    exit 2
    ;;
esac

# --- the reminder itself ---------------------------------------------------
dir=$(archive_dir) || dir=''
if [ -z "$dir" ]; then
    # Already turned off. Say so once in the journal and go quietly: a mail
    # asking someone to undo something they have already undone is noise, and
    # noise is how alerts stop being read.
    echo "ippfix --archive is already off; removing the reminder"
    remove_self
    exit 0
fi

to=${IPPFIX_REMINDER_TO:-root}
since=${IPPFIX_REMINDER_SINCE:-unknown}
host=$(hostname -f 2>/dev/null || hostname)
count=$(find "$dir" -maxdepth 1 -type f ! -name '*.txt' 2>/dev/null | wc -l)
bytes=$(du -sh "$dir" 2>/dev/null | cut -f1)
oldest=$(find "$dir" -maxdepth 1 -type f ! -name '*.txt' -printf '%TY-%Tm-%Td\n' \
         2>/dev/null | sort | head -1)

body=$(cat <<TEXT
ippfix on $host still has --archive enabled, and has since $since.

That flag keeps a copy of every job exactly as it arrived, so the directory
below holds the documents people have printed. It was turned on to catch a
specific fault; if that question has been answered, it should go off again.

  directory:  $dir
  documents:  $count (about ${bytes:-unknown} on disk)
  oldest:     ${oldest:-none}

To turn it off:

  1. Remove --archive DIR from the IPPFIX_ARGS line in $CONF
  2. systemctl restart ippfix
  3. rm -rf $dir

Reports about jobs that did not print keep working without it. They lose only
the attached copy of the document as the client sent it, which is the one thing
that cannot be reconstructed afterwards -- so weigh that against how sensitive
the printing here is.

This reminder has now deleted itself. There is no timer, no unit and no state
left to clean up; turning the flag off is all that remains.
TEXT
)

# From: is the recipient, not ippfix@ this host: the configured address is
# known to route, and an internal-looking sender turns a bounce into a second
# thing that goes missing.
msg="From: ippfix <$to>
To: $to
Subject: ippfix: --archive is still on ($host)
Date: $(date -R)
Auto-Submitted: auto-generated

$body"

# Hand it to the same spool the failure reports use, rather than growing a
# second delivery path with its own retry rules to get wrong.
if [ -d "$SPOOL" ]; then
    f="$SPOOL/$(date +%s)-reminder.mail"
    umask 077
    printf '%s\n' "$msg" > "$f.part" \
        && chown ippfix:ippfix "$f.part" 2>/dev/null \
        && mv "$f.part" "$f" \
        && echo "reminder queued for $to"
else
    printf '%s\n' "$msg" | /usr/sbin/sendmail -f "$to" -t -i \
        && echo "reminder sent to $to"
fi || echo "ippfix-archive-reminder: could not queue the reminder" >&2

remove_self
